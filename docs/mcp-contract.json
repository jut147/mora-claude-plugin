{
  "contractVersion": "2026-08-19",
  "endpoint": "https://app.mora-marketer.com/api/mcp",
  "serverCard": "https://app.mora-marketer.com/.well-known/mcp/server-card.json",
  "authorization": {
    "protectedResourceMetadata": "https://app.mora-marketer.com/.well-known/oauth-protected-resource",
    "authorizationServerMetadata": "https://app.mora-marketer.com/.well-known/oauth-authorization-server",
    "flow": "authorization_code",
    "clientIdentification": "client_id_metadata_document",
    "pkce": "S256",
    "scope": "mora.read",
    "accessToken": "opaque_bearer"
  },
  "tools": [
    "list_posts",
    "get_post_performance",
    "get_brand_profile",
    "get_brief_workspace",
    "list_products",
    "get_revenue_attribution",
    "list_projects",
    "list_audiences",
    "list_content_angles",
    "list_brief_runs"
  ],
  "resources": ["mora://brand/voice"],
  "prompts": [
    "product_hunt_launch_week",
    "first_maker_comment",
    "write_like_what_worked"
  ],
  "scope": {
    "readOnly": true,
    "accountScoped": true
  },
  "limitations": {
    "writes": false,
    "apiKeys": false,
    "dynamicClientRegistration": false,
    "discoverCorpus": false,
    "getStream": false,
    "sessionTeardown": false
  },
  "clientCompatibility": {
    "_note": "Auth is the gate, not UI rendering. This server issues client_id as a CIMD (Client ID Metadata Document) URL and has no /register endpoint, so any client that still depends on Dynamic Client Registration cannot complete authorization here, independent of tool/resource/prompt support.",
    "verified": {
      "2026-08-19": {
        "claude-code": "works (this repository is its connector)",
        "codex-cli-0.147.0": "fails — `codex mcp login` errors immediately with \"Dynamic client registration not supported\"; live-tested against this endpoint"
      }
    },
    "unverified": ["claude-desktop", "vscode", "cursor"]
  }
}
